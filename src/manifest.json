{
  "manifest_version": 3,
  "name": "Enhancer for Physics Wallah",
  "version": "1.0.8.2",
  "description": "Supercharge your PhysicsWallah lectures! Custom video speeds up to 4.0x and 1-click decluttering on pw.live.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pw.live/*",
        "*://*.penpencil.co/*",
        "*://*.penpencil.xyz/*",
        "*://*.pwnet.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}